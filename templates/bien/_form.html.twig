<div class="form-card">
    {{ form_start(form) }}
    <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        {{ form_row(form.titre) }}
        {{ form_row(form.type) }}
        {{ form_row(form.statut) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.localisation) }}
        {{ form_row(form.ascenseur) }}
        {{ form_row(form.parking) }}
    </div>
    <button class="btn">{{ button_label|default('Enregistrer') }}</button>
    {{ form_end(form) }}
</div>
