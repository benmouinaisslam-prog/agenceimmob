{% extends 'base.html.twig' %}

{% block title %}{{ bien.titre }}{% endblock %}

{% block body %}
    <section class="hero">
        <h1>{{ bien.titre }}</h1>
        <p>{{ bien.localisation }} — {{ bien.type|capitalize }}</p>
    </section>

    <div class="grid" style="grid-template-columns: 2fr 1fr; gap: 18px;">
        <article class="card">
            {% if bien.mainImagePath %}
                <img src="/{{ bien.mainImagePath }}" alt="{{ bien.titre }}" style="width:100%;border-radius:12px;">
            {% endif %}
            <div class="pill" style="margin-top:10px;">{{ bien.statut }}</div>
            <p class="meta">Publié le {{ bien.publishedAt ? bien.publishedAt|date('d/m/Y H:i') : 'n.c.' }}</p>
        </article>

        <article class="card">
            <div class="stack">
                <strong>{{ bien.prix|number_format(0, '', ' ') }} €</strong>
                <span class="meta">Ascenseur : {{ bien.ascenseur ? 'Oui' : 'Non' }} • Parking : {{ bien.parking ? 'Oui' : 'Non' }}</span>
                <span class="meta">Localisation : {{ bien.localisation }}</span>
                <span class="meta">Statut : {{ bien.statut }}</span>
                {% if bien.contactVendeur %}
                    <span class="meta">Contact vendeur : {{ bien.contactVendeur }}</span>
                {% endif %}
            </div>
            <div class="card-actions" style="margin-top:12px;">
                <a class="btn outline" href="{{ path('app_bien_index') }}">Retour</a>
            </div>
            {% if app.user %}
                <div class="card-actions" style="margin-top:8px;">
                    <a href="{{ path('app_bien_edit', {'id': bien.id}) }}">Modifier</a>
                    {{ include('bien/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </article>
    </div>
{% endblock %}
