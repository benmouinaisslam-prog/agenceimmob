{% extends 'base.html.twig' %}

{% block title %}Bien{% endblock %}

{% block body %}
    <h1>Bien</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ bien.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ bien.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ bien.description }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ bien.type }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ bien.prix }}</td>
            </tr>
            <tr>
                <th>Surface</th>
                <td>{{ bien.surface }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ bien.adresse }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ bien.statut }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_bien_index') }}">back to list</a>

    <p>
        <a href="mailto:info@example.test?subject={{ 'Inquiry about' ~ ' ' ~ bien.titre }}&body=Hello,%0A%0AI would like more information about "{{ bien.titre }}" (ID: {{ bien.id }}).">Contact seller</a>
    </p>

    {% if app.user %}
        <a href="{{ path('app_bien_edit', {'id': bien.id}) }}">edit</a>

        {{ include('bien/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
